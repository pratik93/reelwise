# TMDB: free key at https://www.themoviedb.org/settings/api
# Either the v3 "API Key" or the v4 "API Read Access Token" works.
TMDB_API_KEY=

# Optional: extra ratings (IMDb / Rotten Tomatoes / Metascore) from https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=

# Database. Local default is a file; for production use a Turso (libSQL) URL.
DATABASE_URL=file:./data/movies.db
DATABASE_AUTH_TOKEN=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
WATCH_REGION=US
